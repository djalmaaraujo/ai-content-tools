PORT=3000
NODE_ENV=development
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
SPECIALIST_MODEL_TECHNICAL=gpt-5.4-mini
SPECIALIST_MODEL_CONTENT=gpt-5.4-mini
SPECIALIST_MODEL_ENTITY=gpt-5.4-mini
SYNTHESIZER_MODEL=gpt-5.4-mini
HTTP_TIMEOUT_MS=10000
ANALYSIS_TTL_MS=86400000
REPORT_LANGUAGE=en

# Optional outbound proxy for the deterministic fetcher.
# Either HTTP_PROXY_URL or HTTPS_PROXY is honored. HTTP_PROXY_URL takes precedence.
HTTP_PROXY_URL=
HTTPS_PROXY=

# Optional comma-separated list of User-Agent strings.
# When unset the deterministic fetcher uses AIContentToolsBot/0.1.
USER_AGENT_POOL=

# Set to false to disable OpenAI web_search for the entity specialist.
# Saves cost; brand judgments fall back to JSON-LD only.
ENABLE_WEB_SEARCH=true

